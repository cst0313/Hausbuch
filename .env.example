# Hausbuch ships with a pre-seeded SQLite at data/hausbuch.db, so you can
# clone + npm install + npm run dev and browse the full corpus immediately
# without any of the keys below. The keys unlock the LIVE features.

# Optional: Gemini 2.5 Flash. Without it, browsing + the seeded data work,
# but the ⌘K agent will not answer, and image / scanned-PDF uploads cannot
# OCR. The fact extractor falls back to a bilingual heuristic.
GEMINI_API_KEY=

# Optional override (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Optional: Anthropic Claude Sonnet 4.6. When set, the fact extractor uses
# Claude with structured output + prompt caching instead of the heuristic.
# Also enables the long-context / RAG baselines on /research.
ANTHROPIC_API_KEY=

# Optional partner integrations — leave blank to disable
TAVILY_API_KEY=
CALA_API_KEY=
GRADIUM_API_KEY=
AIKIDO_API_KEY=
