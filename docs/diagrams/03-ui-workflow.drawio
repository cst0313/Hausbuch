<mxfile host="app.diagrams.net" modified="2026-04-25T00:00:00.000Z" agent="hausbuch" version="22.0.0">
  <diagram id="ui" name="UI Workflow">
    <mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Hausbuch — UI Workflow (a property manager's morning)" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=22;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1300" height="40" as="geometry" />
        </mxCell>

        <!-- Lane 1: Triage -->
        <mxCell id="l1" value="A. TRIAGE — / dashboard" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;fontSize=12;fontStyle=1;startSize=24" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="1280" height="180" as="geometry" />
        </mxCell>
        <mxCell id="t1" value="① Open the dashboard&#xa;Live stat strip: Open · Critical · Drafts · Facts&#xa;Polled every 8s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="t2" value="② Recs sorted by severity&#xa;Critical / High / Medium tray&#xa;Each row: title, entity, summary&#xa;Step indicator (1→4)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="320" y="120" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="t3" value="③ Awaiting-reply rows collapsed&#xa;Sent · awaiting reply&#xa;Outbound exists, no inbound chase yet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="580" y="120" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="t4" value="④ Click a row → expand&#xa;See: facts cited, email chain,&#xa;suggested actions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="840" y="120" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="t5" value="⑤ Resolve &amp; move on&#xa;Close → fact appended,&#xa;rec disappears on next poll" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="1080" y="120" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ta1" style="endArrow=classic;html=1" edge="1" parent="1" source="t1" target="t2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ta2" style="endArrow=classic;html=1" edge="1" parent="1" source="t2" target="t3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ta3" style="endArrow=classic;html=1" edge="1" parent="1" source="t3" target="t4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ta4" style="endArrow=classic;html=1" edge="1" parent="1" source="t4" target="t5"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Lane 2: Action -->
        <mxCell id="l2" value="B. ACT — draft, dispatch, escalate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;fontSize=12;fontStyle=1;startSize=24" vertex="1" parent="1">
          <mxGeometry x="40" y="280" width="1280" height="180" as="geometry" />
        </mxCell>
        <mxCell id="b1" value="① Pre-composed draft reply&#xa;Gemini-generated, cached in&#xa;sessionStorage so re-render&#xa;doesn't re-pay tokens" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="60" y="320" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="b2" value="② Edit before send&#xa;Inline edit field —&#xa;language pinned to tenant's Sprache" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="320" y="320" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="b3" value="③ Dispatch contractor&#xa;Auto-routes to relevant Branche&#xa;(water → sanitär, lock → schlüssel)&#xa;Pre-fills work order" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="580" y="320" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="b4" value="④ Escalate (legal)&#xa;Mietminderung / Anwaltsschreiben:&#xa;flag attorney involvement,&#xa;suspend auto-actions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="840" y="320" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="b5" value="⑤ All actions logged&#xa;/audit shows actor, action,&#xa;entity, ts, latency, tokens" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="1080" y="320" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ba1" style="endArrow=classic;html=1" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ba2" style="endArrow=classic;html=1" edge="1" parent="1" source="b2" target="b3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ba3" style="endArrow=classic;html=1" edge="1" parent="1" source="b3" target="b4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ba4" style="endArrow=classic;html=1" edge="1" parent="1" source="b4" target="b5"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Lane 3: Investigate -->
        <mxCell id="l3" value="C. INVESTIGATE — CmdK · Context.md · sandbox" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;fontSize=12;fontStyle=1;startSize=24" vertex="1" parent="1">
          <mxGeometry x="40" y="480" width="1280" height="180" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="① ⌘K opens agent palette&#xa;Type a question&#xa;Recent 3 queries shown&#xa;and re-clickable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="60" y="520" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="② Agent searches fact store&#xa;Resolves relevant entities,&#xa;loads ≤24KB of Context.md per ent,&#xa;calls Gemini" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="320" y="520" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="③ Cited answer&#xa;Each claim ^[source title]&#xa;Citations are clickable&#xa;→ jump to Source view" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="580" y="520" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="④ Open Context.md&#xa;/context/[entity] —&#xa;Markdown with anchored fact blocks,&#xa;bitemporal valid_from / valid_to" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="840" y="520" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="⑤ Drop a doc → /sandbox&#xa;Watch entities + facts land&#xa;in real-time as the pipeline runs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="1080" y="520" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ca1" style="endArrow=classic;html=1" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ca2" style="endArrow=classic;html=1" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ca3" style="endArrow=classic;html=1" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ca4" style="endArrow=classic;html=1" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Lane 4: Review -->
        <mxCell id="l4" value="D. AUDIT &amp; RESEARCH — verify the system" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;fontSize=12;fontStyle=1;startSize=24" vertex="1" parent="1">
          <mxGeometry x="40" y="680" width="1280" height="180" as="geometry" />
        </mxCell>
        <mxCell id="d1" value="① /audit&#xa;Append-only ledger of every&#xa;LLM call, fact write, dispatch.&#xa;Filter by actor, entity, action" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="60" y="720" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="② /research&#xa;Methods: keyword + LLM classifier,&#xa;Dawid–Skene weighting,&#xa;awaiting-reply detection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="320" y="720" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="d3" value="③ /technical&#xa;Architecture, schema,&#xa;partner integrations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="580" y="720" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="d4" value="④ Replay a date&#xa;valid_from / valid_to means&#xa;&quot;who lived in WE 32 in March?&quot;&#xa;→ correct answer for that date" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="840" y="720" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="d5" value="⑤ Voice mode&#xa;Hold-to-talk button → Gradium STT&#xa;→ /api/agent → cited answer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10" vertex="1" parent="1">
